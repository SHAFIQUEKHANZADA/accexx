# Copy to .env.local and fill in. Never commit real values.

# Public site URL (used for metadata, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://www.accexxinsight.com

# GoHighLevel API integration credentials (server-side only, from .env)
# The integration supports both GHL_PRIVATE_INTEGRATION_TOKEN / GHL_LOCATION_ID and api / loc
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
api=
loc=

# GHL "Consultation with Dr. Laide" calendar (Book Dr. A / Book a Discovery Call)
NEXT_PUBLIC_GHL_BOOKING_URL=

# GHL course portal (Enroll / Student Login)
NEXT_PUBLIC_COURSE_PORTAL_URL=

# Contact & Support Details (defaults configured in src/lib/site.ts)
NEXT_PUBLIC_CONTACT_PHONE=(800) 689-1185
NEXT_PUBLIC_CONTACT_EMAIL=info@accexxinsight.com
NEXT_PUBLIC_STUDENT_SUPPORT_EMAIL=axiacastudent@accexxinsight.com
NEXT_PUBLIC_FACULTY_SUPPORT_EMAIL=axiacafaculty@accexxinsight.com

# Social Profile URLs (defaults configured in src/lib/site.ts)
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/laidealexander/
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/iamdrlaidea/
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@Dr.LaideAlexander
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@drlaidealexander/
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61584887520106

# Checkout provider (not decided yet). Leave empty to show "Checkout coming soon".
CHECKOUT_PROVIDER=
