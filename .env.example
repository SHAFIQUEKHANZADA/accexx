# Copy to .env.local and fill in. Never commit real values.

# Public site URL (used for metadata, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://www.accexxinsight.com

# GoHighLevel inbound webhook that receives every site form (server-side only)
GHL_FORM_WEBHOOK_URL=

# GHL "Consultation with Dr. Laide" calendar (Book Dr. A / Book a Discovery Call)
NEXT_PUBLIC_GHL_BOOKING_URL=

# GHL course portal (Enroll / Student Login)
NEXT_PUBLIC_COURSE_PORTAL_URL=

# Contact details (pending from client; see TODO_CLIENT.md)
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Checkout provider (not decided yet). Leave empty to show "Checkout coming soon".
CHECKOUT_PROVIDER=
